
import numpy as np
import sys
sys.path.insert(0, '.')


from Dense import * 
from NonLinear import *
from Loss import * 


def main():
    np.random.seed(42)

    n_samples, n_features, n_classes = 100, 4, 3
    X = np.random.randn(n_samples, n_features)
    y = np.random.randint(0, n_classes, size=n_samples)

    # reseau : 4 -> Dense(8) -> ReLU -> Dense(3) -> Softmax
    layer1 = Dense(n_features, 8)
    relu = ReLU()
    layer2 = Dense(8, n_classes)
    softmax = Softmax()
    loss_fn = CrossEntropyLoss()

    lr = 0.1

    for epoch in range(200):
        # forward
        z1 = layer1.forward(X)
        a1 = relu.forward(z1)
        z2 = layer2.forward(a1)
        probs = softmax.forward(z2)

        loss = loss_fn.forward(probs, y)
        acc = np.mean(np.argmax(probs, axis=1) == y) * 100

        # backward (ordre inverse)
        grad = loss_fn.backward()
        grad = softmax.backward(grad)
        grad = layer2.backward(grad)
        grad = relu.backward(grad)
        grad = layer1.backward(grad)

        # update des poids
        layer1.update(lr)
        layer2.update(lr)

        if epoch % 20 == 0 or epoch == 199:
            print(f"epoch {epoch:3d} | loss: {loss:.4f} | acc: {acc:.1f}%")

    print("\nca marche, la loss descend.")


if __name__ == "__main__":
    main()